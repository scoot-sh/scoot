/target
result
result-*
.direnv
HANDOFF.md

# Local-only machine access / scratch notes (e.g. ASAHI.local.md)
*.local.md

# devenv state (devenv.lock is tracked)
.devenv*
devenv.local.nix
devenv.local.yaml
__pycache__/

# The docs site's build outputs and fetched dependencies (site/pnpm-lock.yaml
# is tracked; what it fetches is not).
/site/node_modules/
/site/dist/
/site/.astro/

# libFuzzer drops reproducers in its working directory when a `-fork` run
# ignores its `-artifact_prefix` (crates/scootbg/fuzz/README.md): a crash
# worth keeping is copied to fuzz/regressions/ by hand, never committed
# from here.
/crates/scootbg/crash-*
/crates/scootbg/oom-*
/crates/scootbg/timeout-*
/crates/scootbg/slow-unit-*
