# scoot-git: the scrolling-tiling Wayland compositor, tracking main.
#
# The `-git` twin of `scoot` (packaging/arch/scoot/PKGBUILD): same files,
# same dependencies, but built from the tip of main instead of the tagged
# release tarball. `pkgver` is the last release tag plus the commits
# since it (the binaries' own build label), so every rebuild sorts past
# the last. Conflicts with `scoot`: install one or the other, never both
# (the versioned `scootbg` dependency stays satisfied by `scootbg-git`,
# which provides `scootbg`).

pkgname=scoot-git
pkgver=0.2.1.r0.g0000000
pkgrel=1
pkgdesc='Scrolling-tiling Wayland compositor (auto CPU/GPU rendering, runs without a GPU) (git)'
arch=('x86_64' 'aarch64')
url='https://github.com/scoot-sh/scoot'
license=('MIT')
depends=('glibc' 'libgcc' 'libinput' 'libxkbcommon' 'pixman' 'scootbg' 'seatd' 'sh' 'systemd-libs')
makedepends=('cargo' 'cargo-deny' 'git' 'wayland' 'wayland-protocols')
optdepends=('mesa: GPU scanout tier at run time (auto-detected, no rebuild needed)'
            'libdrm: GPU scanout tier at run time (auto-detected, no rebuild needed)'
            'systemd: greeter session login through scoot-session')
provides=('scoot')
conflicts=('scoot')
install=scoot.install
options=('!debug')
source=("$pkgname::git+https://github.com/scoot-sh/scoot.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  # The binaries' own label in pacman's spelling: `scoot --version` saying
  # 0.2.0+14.g615608c is pkgver 0.2.0.r14.g615608c (the last v* release
  # tag, the commits since it, the commit; docs/versioning.md). Before
  # the first tag: the workspace version and every commit.
  local desc
  if desc=$(git describe --long --tags --abbrev=7 --match 'v[0-9]*' --exclude 'v*-*' 2>/dev/null); then
    printf '%s' "$desc" | sed 's/^v//;s/-\([0-9]*\)-g\([0-9a-f]*\)$/.r\1.g\2/'
  else
    printf '%s.r%s.g%s' \
      "$(sed -n '/^\[workspace\.package\]/,/^\[/s/^version = "\(.*\)"$/\1/p' Cargo.toml | head -1)" \
      "$(git rev-list --count HEAD)" \
      "$(git rev-parse --short=7 HEAD)"
  fi
}

build() {
  cd "$pkgname"
  cargo build --release --locked -p scoot
  cargo deny list > THIRD-PARTY-LICENSES
  "${CARGO_TARGET_DIR:-target}/release/scoot" --print-default-config > config.toml.example
}

package() {
  cd "$pkgname"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/scoot" "$pkgdir/usr/bin/scoot"
  install -Dm755 resources/scoot-session "$pkgdir/usr/bin/scoot-session"
  install -Dm644 packaging/arch/scoot/scoot.desktop "$pkgdir/usr/share/wayland-sessions/scoot.desktop"
  install -Dm644 resources/systemd/user/scoot-session.target "$pkgdir/usr/lib/systemd/user/scoot-session.target"
  install -Dm644 resources/systemd/user/scoot-shutdown.target "$pkgdir/usr/lib/systemd/user/scoot-shutdown.target"
  sed 's|@SCOOT_BIN@|/usr/bin/scoot|g' resources/systemd/user/scoot.service > "$pkgdir/usr/lib/systemd/user/scoot.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/scoot.service"
  install -Dm644 resources/scoot-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/scoot-portals.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
  install -Dm644 config.toml.example "$pkgdir/usr/share/doc/scoot/config.toml.example"
}
