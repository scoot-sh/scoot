[Unit]
Description=scoot GlobalShortcuts portal backend
PartOf=scoot-session.target
After=scoot-session.target
StartLimitIntervalSec=0

[Service]
# D-Bus activation (`Type=dbus` plus the name): the unit is started
# when claimed, and considered started once the daemon owns the name.
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.scoot
# Activation can arrive before the session reaches the session target
# (a portal call in an early autostart): skip cleanly then -- no
# restart -- and the next call re-activates. The wanted-by below starts
# it with the display in the common case.
ExecCondition=bash -c '[ -n "$WAYLAND_DISPLAY" ]'
ExecStart=/usr/bin/scoot-globalshortcuts-portal daemon
Restart=on-failure
RestartSec=1
# A taken name (another GlobalShortcuts backend still running) is the
# daemon's exit 3: a stopped unit, never a restart loop.
RestartPreventExitStatus=3

[Install]
WantedBy=scoot-session.target
