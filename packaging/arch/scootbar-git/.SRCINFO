pkgbase = scootbar-git
	pkgdesc = Status bar for the scoot compositor (git)
	pkgver = 0.1.0.r0.g0000000
	pkgrel = 1
	url = https://github.com/scoot-sh/scoot
	install = scootbar.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = cargo-deny
	makedepends = git
	makedepends = wayland
	makedepends = wayland-protocols
	depends = gcc-libs
	depends = glibc
	optdepends = systemd: run the bar as a user unit (scootbar.service)
	optdepends = ttf-dejavu: sans font the bar finds on its own
	provides = scootbar
	conflicts = scootbar
	source = scootbar-git::git+https://github.com/scoot-sh/scoot.git
	sha256sums = SKIP

pkgname = scootbar-git
