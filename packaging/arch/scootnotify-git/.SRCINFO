pkgbase = scootnotify-git
	pkgdesc = Notification daemon for the scoot compositor (git)
	pkgver = 0.6.17.r0.g0000000
	pkgrel = 1
	url = https://github.com/scoot-sh/scoot
	install = scootnotify.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	makedepends = cargo-deny
	makedepends = git
	makedepends = wayland
	makedepends = wayland-protocols
	depends = glibc
	depends = libgcc
	optdepends = systemd: run the daemon as a user unit (scootnotify.service)
	optdepends = ttf-dejavu: sans font the cards find on their own
	provides = scootnotify
	conflicts = scootnotify
	options = !debug
	source = scootnotify-git::git+https://github.com/scoot-sh/scoot.git
	sha256sums = SKIP

pkgname = scootnotify-git
