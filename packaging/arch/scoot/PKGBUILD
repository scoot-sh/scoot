# scoot: the scrolling-tiling Wayland compositor (release build).
#
# Built from the tagged release tarball (`v$pkgver`), the default
# cargo feature set: the single build, which runs on a box with no GPU
# stack installed and scans out from the GPU where there is one (the
# `gpu-scanout` tier is on by default and reaches libgbm at run time, so
# no libgbm link dependency). The `xwayland` tier is compiled in by
# default too; enabling it needs the Xwayland binary on PATH plus the
# runtime opt-in (`--xwayland` / `[xwayland] enabled`).
# The default build compiles a small C stub (`crates/scoot/gbm-stub/`),
# so a C compiler is needed at build time (base-devel, which makepkg
# assumes; CI installs it explicitly).
#
# The versioned `scootbg` dependency is the coupled pair from
# docs/backlog/resolved/arch-package-done.md: one tag releases every binary
# at the repository's one version (docs/versioning.md), so the pair
# installs at that version.
# No tag is cut yet, so `sha256sums` is SKIP until the first release;
# `updpkgsums` fills it then (see packaging/arch/README.md). CI builds
# this exact file against a same-layout tarball of HEAD.

pkgname=scoot
pkgver=0.4.1
pkgrel=1
pkgdesc='Scrolling-tiling Wayland compositor (auto CPU/GPU rendering, runs without a GPU)'
arch=('x86_64' 'aarch64')
url='https://github.com/scoot-sh/scoot'
license=('MIT')
depends=('glibc' 'libgcc' 'libinput' 'libxkbcommon' 'pixman' "scootbg=$pkgver" 'seatd' 'sh' 'systemd-libs')
makedepends=('cargo' 'cargo-deny' 'git' 'wayland' 'wayland-protocols')
optdepends=('mesa: GPU scanout tier at run time (auto-detected, no rebuild needed)'
            'libdrm: GPU scanout tier at run time (auto-detected, no rebuild needed)'
            'systemd: greeter session login through scoot-session')
install=scoot.install
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::https://github.com/scoot-sh/scoot/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "scoot-$pkgver"
  # Rust 1.99 links this target with lld by default, whose strict -L
  # ordering leaves build.rs's static libgbm stub archive unpulled (its
  # OUT_DIR -L arrives after the -lgbm): the link fails on undefined gbm_*
  # plus scoot_gbm_real_loaded. bfd keeps the previous order-tolerant
  # behavior with identical output (no libgbm DT_NEEDED; the stub still
  # forwards by dlopen, mesa stays an optdepend). Revisit when build.rs
  # links the archive by absolute path instead of -l plus -L.
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C link-arg=-fuse-ld=bfd"
  cargo build --release --locked -p scoot
  cargo deny list > THIRD-PARTY-LICENSES
  "${CARGO_TARGET_DIR:-target}/release/scoot" --print-default-config > config.toml.example
}

package() {
  cd "scoot-$pkgver"
  install -Dm755 "${CARGO_TARGET_DIR:-target}/release/scoot" "$pkgdir/usr/bin/scoot"
  install -Dm755 resources/scoot-session "$pkgdir/usr/bin/scoot-session"
  install -Dm644 packaging/arch/scoot/scoot.desktop "$pkgdir/usr/share/wayland-sessions/scoot.desktop"
  install -Dm644 resources/systemd/user/scoot-session.target "$pkgdir/usr/lib/systemd/user/scoot-session.target"
  install -Dm644 resources/systemd/user/scoot-shutdown.target "$pkgdir/usr/lib/systemd/user/scoot-shutdown.target"
  sed 's|@SCOOT_BIN@|/usr/bin/scoot|g' resources/systemd/user/scoot.service > "$pkgdir/usr/lib/systemd/user/scoot.service"
  chmod 644 "$pkgdir/usr/lib/systemd/user/scoot.service"
  install -Dm644 resources/scoot-portals.conf "$pkgdir/usr/share/xdg-desktop-portal/scoot-portals.conf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 THIRD-PARTY-LICENSES "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-LICENSES"
  install -Dm644 config.toml.example "$pkgdir/usr/share/doc/$pkgname/config.toml.example"
}
