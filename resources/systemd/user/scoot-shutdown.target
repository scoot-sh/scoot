# `scoot-shutdown.target`: how a scoot session ends.
#
# `scoot-session` starts this when the compositor exits (or when the
# launcher itself is signalled). `Conflicts=` stops the session targets,
# which -- through `BindsTo` on `scoot.service` and `PartOf` on
# session-bound units like the status bar -- stops everything the
# session started, so nothing leaks into the next login. `After` orders
# the stop after the targets were active; `StopWhenUnneeded` and
# `DefaultDependencies=no` keep it from being pulled in or held by
# anything but the explicit start (the dependency shape follows the niri
# `niri-shutdown.target` unit; written for scoot, not copied).
[Unit]
Description=Shutdown for the scoot session
DefaultDependencies=no
StopWhenUnneeded=true
Conflicts=graphical-session.target graphical-session-pre.target
After=graphical-session.target graphical-session-pre.target
