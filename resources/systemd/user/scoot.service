# `scoot.service`: the compositor inside the user session.
#
# Started by `scoot-session` (the greeter entry command), never enabled
# directly: the launcher waits for IPC readiness and only then imports
# `WAYLAND_DISPLAY`/`XDG_CURRENT_DESKTOP`, which is what makes units
# ordered after `graphical-session.target` see the display. `BindsTo`
# ties this unit to the session target lifetime -- when the target
# stops (see `scoot-shutdown.target`), so does the compositor -- and
# `Before` orders target activation after this unit starts. (The
# target carries `RefuseManualStart=yes` and can only be pulled in by a
# dependency like this one, never by `systemctl start`.)
#
# `Type=simple` and no notify: scoot reports readiness over its IPC
# socket (`scoot msg version`), which the launcher polls -- the
# compositor never touches the bus, and there is no `sd_notify` to wait
# on. `Restart=no` (the default, stated): a crash costs every client
# its unsaved state, and silently relaunching into a fresh session
# would hide that; the launcher exits nonzero instead.
#
# Install: the NixOS module (`programs.scoot.session.enable`) writes
# these files with the package binary path filled in. The dependency
# shape follows the niri `niri.service` unit (niri is GPL-3.0, scoot is
# MIT: the semantics belong to systemd, and the files are written for
# scoot, not copied).
[Unit]
Description=scoot scrolling-tiling Wayland compositor
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=@SCOOT_BIN@ --tty
Slice=session.slice
