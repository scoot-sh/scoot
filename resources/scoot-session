#!/bin/sh
# scoot-session: log into a whole scoot desktop, not just a compositor.
#
# A greeter (greetd, GDM, SDDM -- anything reading `wayland-sessions`)
# runs this instead of `scoot --tty` directly. It wires the compositor
# into the systemd user session around it:
#
#   1. refuse while a live scoot session is already active for this
#      user -- but clear a stale one (units active, the lock below
#      free, compositor silent on IPC: SIGKILL and power loss leave
#      no trap to run, and the kernel releases the lock) and continue
#      the login instead of refusing every retry until someone runs
#      systemctl from a VT;
#   2. import the login environment into the user manager AND the D-Bus
#      activation environment, so units the session starts later
#      inherit it (with the session-identity defaults below already
#      exported, so the bus agrees with what scoot's own children get);
#   3. start `scoot.service` and wait until the compositor answers IPC
#      (polled with a deadline, never a blind sleep);
#   4. import `WAYLAND_DISPLAY`, `XDG_CURRENT_DESKTOP` and
#      `XDG_SESSION_TYPE` into the user
#      manager AND the D-Bus activation environment, so units ordered
#      after `graphical-session.target` (the status bar, portals) see
#      the display, and D-Bus-activated portals and apps (notably
#      Chrome, which picks its Wayland screen capturer only with
#      `XDG_SESSION_TYPE=wayland`) see the session for what it is;
#   5. start `scoot-session.target` -- and only now: its `BindsTo`
#      pulls in `graphical-session.target`, so the target is reached
#      only after the display is in the manager (a unit the service
#      start pulled in would activate at fork time, before the import,
#      and `ConditionEnvironment=WAYLAND_DISPLAY` units would skip);
#   6. when scoot exits, stop the session targets (via
#      `scoot-shutdown.target`, which `Conflicts=` them) so
#      session-bound user services stop instead of leaking into the
#      next login, and restore the manager environment to its
#      pre-session state.
#
# scoot itself never touches the bus -- that is deliberate, and it stays
# that way: everything bus-shaped happens here, in the launcher, not in
# the compositor. There is no `--session` flag and no `Type=notify`;
# readiness is "the IPC socket answers `version`", and the display name
# is the session's own new Wayland socket (see below), never guessed.
#
# Without a systemd user manager (s6, a seat with no manager, the webtop
# target) this degrades to `exec scoot --tty` with a note on stderr: a
# session with no session integration, not a failure. When the missing
# manager is a `user-light` login (TTY autologin never starts
# `user@UID.service`) the note names that cause and its one-line fix,
# and mirrors the diagnosis into the system journal (the compositor
# takes over the tty on exec, burying stderr).
#
# Takes no arguments. Startup programs belong in scoot's `[autostart]`
# (config), which runs inside the wired session -- not on this command
# line, which a static `scoot.service` could not receive exactly (shell
# word-splitting would break the quoting a session command needs).
#
# A polkit authentication agent, optionally, in the session scope
# (`SCOOT_POLKIT_AGENT`, a bare executable path, no arguments -- see
# below). A polkit agent registers against its own logind session,
# and a systemd user unit never joins one (this kernel has no audit,
# so the session scope is the only signal polkit has): an agent run
# as a unit fails registration with "User of caller and user of
# subject differs" and serves no prompt, ever. This script IS the
# session (the greeter runs it as the session command), so a set
# `SCOOT_POLKIT_AGENT` spawns here -- after the display is known,
# which the agent needs -- supervised like the units (a dead agent
# restarts after 2 s) and stopped with the session. Unset: nothing
# runs (headless sessions fail privileged actions loud through
# polkit's own no-agent refusal, by design).
#
# Shape follows niri's `niri-session` (refuse-if-active, reset-failed,
# import, start, shutdown target, unset), reworked for the constraint
# above -- and where it differs, deliberately: plain `start` (see
# below), restore-instead-of-unset, a readiness wait niri gets from
# `Type=notify`. niri is GPL-3.0 and scoot is MIT: this file is written
# for scoot, not copied from niri.
set -u

SERVICE=scoot.service
SESSION=scoot-session.target
SHUTDOWN=scoot-shutdown.target
GRAPHICAL=graphical-session.target
# How long to wait for the compositor to answer IPC after the service
# starts, in whole seconds (integer: POSIX `sleep` has no fractions).
READY_TIMEOUT=60

# The compositor beside this script (`$out/bin` carries both), unless
# the caller knows better. This is what keeps the XWayland wrapper on
# PATH: that package wraps `bin/scoot`, and this resolves to the wrapper.
SCOOT_BIN="${SCOOT_BIN:-$(dirname "$0")/scoot}"

die() {
    echo "scoot-session: $*" >&2
    # A starting agent must not outlive a refused login (it would
    # keep answering prompts for a session that never started):
    # stop it before restoring the environment and exiting. Unset
    # (no agent configured, or dying before it started) is a no-op.
    stop_agent 2>/dev/null || true
    # Leave the manager environment as it was found: anything past the
    # pre-session capture (below) already imported the login environment
    # and possibly defaulted the desktop name. The refusal above runs
    # before any of that (`captured` unset) and must not touch another
    # session's environment.
    if [ -n "${captured:-}" ]; then
        restore_session_env
    fi
    exit 1
}

note() {
    echo "scoot-session: $*" >&2
}

# Back to the pre-session state for the three session variables: a
# lingering manager must not offer the next login this session's
# display -- but only what this session set goes away. Any variable
# may have predated it (an ssh-forwarded display, say); then its old
# value is restored instead of removed.
restore_session_env() {
    if [ -n "${prev_display:-}" ]; then
        systemctl --user set-environment "WAYLAND_DISPLAY=$prev_display" >/dev/null 2>&1 || true
    else
        systemctl --user unset-environment WAYLAND_DISPLAY >/dev/null 2>&1 || true
    fi
    if [ -n "${prev_desktop:-}" ]; then
        systemctl --user set-environment "XDG_CURRENT_DESKTOP=$prev_desktop" >/dev/null 2>&1 || true
    else
        systemctl --user unset-environment XDG_CURRENT_DESKTOP >/dev/null 2>&1 || true
    fi
    if [ -n "${prev_session_type:-}" ]; then
        systemctl --user set-environment "XDG_SESSION_TYPE=$prev_session_type" >/dev/null 2>&1 || true
    else
        systemctl --user unset-environment XDG_SESSION_TYPE >/dev/null 2>&1 || true
    fi
}

if [ "$#" -ne 0 ]; then
    die "takes no arguments (startup programs belong in [autostart]); got: $*"
fi

if [ ! -x "$SCOOT_BIN" ]; then
    die "no executable compositor at $SCOOT_BIN (set SCOOT_BIN to override)"
fi

# No user manager: a session with no integration, not a failure.
if ! systemctl --user list-units >/dev/null 2>&1; then
    note "no systemd user manager; running $SCOOT_BIN --tty directly with no session integration (no $GRAPHICAL, no D-Bus activation import)"
    # Name the cause when it is known: a `user-light` login (TTY
    # autologin) never starts `user@UID.service`, so the manager is
    # absent by session design rather than merely unreachable -- and
    # the fix is one line (lingering for this user). Anything else
    # keeps the generic note above: a missing manager elsewhere (s6,
    # a seat with no manager, the webtop target) wants no linger.
    # Best-effort throughout: no loginctl, no session id, or an
    # unanswerable query all keep the generic note.
    _scoot_class=""
    if [ -n "${XDG_SESSION_ID:-}" ] && command -v loginctl >/dev/null 2>&1; then
        _scoot_class=$(loginctl show-session "$XDG_SESSION_ID" -p Class --value 2>/dev/null) || _scoot_class=""
    fi
    if [ "$_scoot_class" = "user-light" ]; then
        _scoot_who=$(id -un 2>/dev/null || printf '%s' "${USER:-<user>}")
        _scoot_why="this login is a 'user-light' session (TTY autologin never starts user@UID.service); for the full session set users.users.\"$_scoot_who\".linger = true and log back in, or log in through the greeter"
        note "$_scoot_why"
        # The compositor takes over this tty on the exec below, burying
        # both notes: mirror the diagnosis into the system journal
        # (best-effort), so it survives the login (`journalctl -b -t
        # scoot-session` from the session's own terminal).
        if command -v systemd-cat >/dev/null 2>&1; then
            printf '%s\n' "$_scoot_why" | systemd-cat -t scoot-session -p warning 2>/dev/null || true
            note "this diagnosis is also in the system journal: journalctl -b -t scoot-session"
        fi
    fi
    exec "$SCOOT_BIN" --tty
fi

# IPC readiness probe, shared by the stale-session check below and the
# readiness wait further down: "answers" means the loop that serves the
# session is running. Each attempt runs under a timeout: mid-startup
# the socket can accept a connection it never answers (the loop is not
# running yet), and a bare client would block in `read` past every
# deadline around it. (`timeout(1)` is coreutils, always beside
# systemd; without it the attempt runs bare, as before.)
if command -v timeout >/dev/null 2>&1; then
    try_version() { timeout 2 "$SCOOT_BIN" msg version >/dev/null 2>&1; }
else
    try_version() { "$SCOOT_BIN" msg version >/dev/null 2>&1; }
fi

# Telling "the service is not active" from "the manager could not be
# asked": every NixOS switch re-execs every user manager, and while the
# manager is gone (a sub-second window) `systemctl --user` cannot be
# asked at all -- it exits 1, which `is-active --quiet` reads as
# "inactive", ending the session and orphaning the compositor. So no
# liveness question here goes through `is-active` or `is-failed`: the
# primitive is `show -p ActiveState --value`, whose nonzero exit means
# "could not ask" and whose printed state is the definite answer. (This
# is also what systemctl(1) in the shipped systemd 261 says to do: its
# Exit-status section calls the LSB return-code mapping imperfect and
# says "it is better to not rely on those return values but to look for
# specific unit states and substates instead." Measured on 261: a
# known-inactive unit shows `inactive` (rc 0; `is-active` rc 3), an
# unknown unit shows `inactive` (rc 0; `is-active` rc 4), an unreachable
# manager fails rc 1 both ways.)
#
# service_state <unit>: print the unit's ActiveState; exit 1 when the
# manager could not be asked (or answered empty, which must never read
# as idle).
service_state() {
    _scoot_state=$(systemctl --user show -p ActiveState --value "$1" 2>/dev/null) || return 1
    [ -n "$_scoot_state" ] || return 1
    printf '%s' "$_scoot_state"
}
# service_object_path <unit>: print the unit's D-Bus object path (for the
# blocking wait below); exit 1 when the manager could not be asked or the
# unit is not loaded. The path is the escaped unit name and never moves
# while the unit stays loaded, so it is kept across wakes and only
# re-resolved while unset (a transient failure costs rounds of polling,
# not the session -- see the loop top).
service_object_path() {
    _scoot_call=$(busctl --user call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager GetUnit s "$1" 2>/dev/null) || return 1
    _scoot_path=$(printf '%s' "$_scoot_call" | sed -n 's/^o "\(.*\)"$/\1/p')
    [ -n "$_scoot_path" ] || return 1
    printf '%s' "$_scoot_path"
}
# unit_up <state>: exit 0 when an ActiveState string means the unit is
# here or on its way up. `activating` counts: measured on 261,
# `is-active` reports 3 all through `ExecStartPre` while the start job
# runs, and a unit mid-start is not a stopped unit (the old code died
# "stopped while starting" if its first readiness poll landed there --
# masked only because the `version` probe runs first). `reloading`
# counts the same way: a reloading service is running. Everything else
# -- `inactive`, `deactivating`, `failed` -- is down, exactly as
# `is-active` read it before.
unit_up() {
    case "$1" in
        active | activating | reloading) return 0 ;;
        *) return 1 ;;
    esac
}
# service_up <unit>: exit 0 up, 1 definitely down, 2 the manager could
# not be asked. Callers retry on 2 (bounded, loudly) and only act on a
# definite answer.
service_up() {
    _scoot_up=$(service_state "$1") || return 2
    unit_up "$_scoot_up"
}
# stop_service: `stop` until the manager answers, bounded. The teardown
# paths below promise "stopped the service" in their `die` lines; a
# single unanswered call during a re-exec must not make that a lie (nor
# orphan the unit). Past the bound the caller still dies -- the next
# login heals or refuses the leftover -- but says so.
stop_service() {
    _scoot_tries=0
    while ! systemctl --user stop "$SERVICE" >/dev/null 2>&1; do
        _scoot_tries=$((_scoot_tries + 1))
        if [ "$_scoot_tries" -ge 5 ]; then
            return 1
        fi
        sleep 1
    done
    return 0
}

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    die "XDG_RUNTIME_DIR is unset; cannot find the compositor's sockets"
fi

# Liveness lock, held by the live launcher from before the
# refuse-or-heal check below until it exits. A second login must not
# judge an IPC-silent session stale: between `start` returning and the
# compositor answering IPC lies up to a minute of silence, and a live
# session can be briefly too busy to answer one probe. So silence
# alone never means death -- only the lock holder may say so. Lock
# held by another launcher means starting or live: refuse at once,
# whatever IPC or the units say (the holder takes the lock before
# importing the environment, well before `start`, so the units may
# not be active yet). Lock acquired here, with the units active and
# IPC silent, means stale:
# heal. The kernel releases the lock on SIGKILL (and every exit
# closes the fd), which is exactly the stale case healing exists for;
# power loss leaves the file behind but unlocked.
# The fd stays open in this launcher until exit and is never closed
# early: this launcher must not take the lock, release it and race the
# launcher it just refused. `scoot.service` is spawned by the user
# manager, not forked from here, so nothing long-lived inherits the
# fd -- every child this script spawns (`systemctl`, `scoot msg`, the
# D-Bus tool) is short-lived and exits before the launcher, so
# inheriting the fd for its own lifetime is harmless, and the one
# long-lived child (the agent watcher, when configured) closes it on
# entry (see `start_agent`). One narrow
# exception: an in-flight child orphaned by a SIGKILL keeps its
# inherited fd until it exits (at most ~`timeout 2`), so a login in
# the second after the kill still refuses once and heals on retry --
# a single refused retry, never a wedge. (POSIX sh has
# no `{fd}>` names and no close-on-exec spelling; fd 9 is otherwise
# unused by this script.) Without `flock(1)` there is no lock to
# consult, so there is no healing: an active session is refused as
# live (the pre-healing behaviour), never cleared blind.
have_lock=0
have_flock=0
# The background bus waiter of the session wait below (empty: none live).
# Initialised here -- before the traps -- so `cleanup`'s `reap_waiter`
# never reads an unset variable under `set -u`, whatever point of the
# login a signal lands at.
_scoot_waiter=""
# The supervised agent's watcher loop (empty: no agent configured).
# Same reason as above: `stop_agent` in `die`/`cleanup` must never
# read it unset.
agent_watch=""
if command -v flock >/dev/null 2>&1; then
    have_flock=1
    exec 9>"$XDG_RUNTIME_DIR/scoot-session.lock" \
        || die "cannot open $XDG_RUNTIME_DIR/scoot-session.lock"
    if flock -n 9 2>/dev/null; then
        have_lock=1
    fi
else
    note "no flock(1) on PATH; stale-session healing disabled (an active session is refused as live)"
fi

# A lock held by another launcher means a session is starting or
# live: refuse at once, whatever the units' state. The holder takes
# the lock before importing the environment, well before `start`, so
# arriving here while no unit is active yet is the normal shape of a
# second login racing the first -- without this, both launchers would
# start and wait on the same service, both importing the display and
# both tearing down on exit. (Without `flock(1)` there is no lock to
# consult, so the old refuse-when-active behaviour below stands.)
if [ "$have_flock" -eq 1 ] && [ "$have_lock" -eq 0 ]; then
    die "a scoot session is already starting or running for this user"
fi

# Three-way liveness, never two-way: if the manager cannot be asked
# (mid-re-exec), neither "live" nor "stale" is known -- refusing the
# login is the safe direction (a retry lands past the window), while
# healing blind could stop a live session and proceeding blind could
# start a second one over it.
svc_state=$(service_state "$SERVICE") || svc_state="unknown"
sess_state=$(service_state "$SESSION") || sess_state="unknown"
gfx_state=$(service_state "$GRAPHICAL") || gfx_state="unknown"
if [ "$svc_state" = "unknown" ] || [ "$sess_state" = "unknown" ] || [ "$gfx_state" = "unknown" ]; then
    die "cannot reach the systemd user manager; refusing this login rather than judging a session that may be live (retry the login)"
fi
if unit_up "$svc_state" || unit_up "$sess_state" || unit_up "$gfx_state"; then
    # A live session refuses: two live scoot sessions for one user on
    # one seat is still wrong. A stale one -- units left active with
    # no lock holder by a launcher that died without cleanup (SIGKILL,
    # power loss: paths no trap can cover, and the kernel already
    # released the lock) -- is cleared instead, or every later login
    # would be refused until someone runs systemctl from a VT.
    # No lock to consult here (`flock(1)` missing: a lock held by
    # another launcher already refused above, before probing) -- so
    # refuse an active session as live, never clear blind.
    if [ "$have_lock" -eq 0 ]; then
        die "a scoot session is already running for this user (found $SERVICE, $SESSION or $GRAPHICAL active)"
    fi
    # `graphical-session.target` is shared with other desktops, so a
    # stale clear stops only scoot's own units -- the service (and its
    # failed state) and the session target -- never the graphical
    # target itself: an active graphical target with scoot's units
    # never run is another session's, and the refusal stands, since
    # stopping it would tear down another desktop's bound services in
    # the same user manager, while a stale-active target does not hurt
    # the new login (the display variables are re-imported below). (If
    # that ever misfires -- another desktop running in this same user
    # manager beside a stale scoot unit -- stop the units by hand:
    # `systemctl --user stop scoot.service scoot-session.target
    # graphical-session.target`, then log in again.)
    if try_version; then
        die "a scoot session is already running for this user (found $SERVICE, $SESSION or $GRAPHICAL active)"
    fi
    # Re-asked (the manager may have re-execed since the check above):
    # an unanswerable manager refuses, never heals blind. Heals when
    # the service is up or failed, or when the session target is up
    # (a SIGKILLed launcher can leave the target active with the
    # service already gone); a unit stopping on its own
    # (`deactivating`) is not ours to clear -- refusing one login beats
    # fighting its teardown (it settles in seconds, the retry proceeds).
    svc_state=$(service_state "$SERVICE") || svc_state="unknown"
    sess_state=$(service_state "$SESSION") || sess_state="unknown"
    if [ "$svc_state" = "unknown" ] || [ "$sess_state" = "unknown" ]; then
        die "cannot reach the systemd user manager; refusing this login rather than judging a session that may be live (retry the login)"
    fi
    if unit_up "$svc_state" || [ "$svc_state" = "failed" ] || unit_up "$sess_state"; then
        note "found $SERVICE, $SESSION or $GRAPHICAL active but the compositor does not answer IPC; clearing the stale session"
        systemctl --user stop "$SESSION" >/dev/null 2>&1 || true
        stop_service || note "warning: could not stop $SERVICE; it may still be active (a later login heals or refuses it)"
        systemctl --user reset-failed "$SERVICE" >/dev/null 2>&1 || true
    else
        die "a scoot session is already running for this user (found $SERVICE, $SESSION or $GRAPHICAL active)"
    fi
fi

# A previous crash leaves the unit in `failed`, which `start` would
# still honour: clear the failed state (and the rate-limit counters)
# so the polls below read the new start, not the old death.
systemctl --user reset-failed "$SERVICE" >/dev/null 2>&1 || true

# The Wayland sockets already here (stale ones from dead sessions,
# another compositor's, another login sharing the directory): the
# display is whichever socket scoot itself creates below, i.e. one not
# on this list. Recorded as `name:inode`, space-joined and space-padded
# and matched with its padding: scoot reuses a stale name by replacing
# its file, which changes the inode, so a reused name still shows up as
# new below. (A Wayland socket name never contains a space; an inode
# never does.)
snap_before=" "
for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$sock" ] || continue
    snap_before="$snap_before${sock##*/}:$(stat -c %i "$sock" 2>/dev/null || echo 0) "
done

# What the manager environment holds for the three session variables
# before this session: restored on the way out (and on every `die`
# past this point) -- see `restore_session_env`.
captured=""
prev_display=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^WAYLAND_DISPLAY=//p' | head -n 1)
prev_desktop=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_CURRENT_DESKTOP=//p' | head -n 1)
prev_session_type=$(systemctl --user show-environment 2>/dev/null | sed -n 's/^XDG_SESSION_TYPE=//p' | head -n 1)
captured=1

# Tear the session down even when this script, not scoot, dies first
# (a HUP at logout, a TERM around it): stopping the session targets
# stops everything bound to them -- the compositor through `PartOf`
# `scoot-session.target`, the profile's units through theirs -- so
# nothing leaks into the next login.
# `replace-irreversibly` so teardown wins over stray start jobs.
# Installed here, right after the environment capture and before
# `start`: `cleanup` (unlike `die`) restores unconditionally, so any
# earlier would unset another session's display variables, and any
# later would leave the readiness wait without a handler -- a scoot
# that wedges at startup (or a logind SIGTERM then) would leave the
# service active and refuse every later login. An early `start
# "$SHUTDOWN"` with no service yet is a harmless no-op (`|| true`).
cleanup() {
    # A signal mid-wait must not orphan the background bus waiter (its
    # connection would linger until the next property change): reap it
    # first. Past the session wait `_scoot_waiter` is already empty (and
    # `reap_waiter` is a no-op there), so calling it here is always safe.
    reap_waiter 2>/dev/null || true
    # The supervised agent ends with the session (the scope reaps
    # stragglers anyway, but an explicit stop beats relying on it).
    stop_agent 2>/dev/null || true
    # The manager may be mid-re-exec at this very moment (a re-exec
    # landing on the session wait kills the wait AND this call
    # together): retry until it answers, bounded, so one unanswered
    # call never orphans the compositor. Past the bound the manager is
    # gone with the session, and there is nothing left to stop.
    _scoot_tries=0
    while ! systemctl --user start --job-mode=replace-irreversibly "$SHUTDOWN" >/dev/null 2>&1; do
        _scoot_tries=$((_scoot_tries + 1))
        if [ "$_scoot_tries" -ge 10 ]; then
            note "user manager still not answering; could not stop $SHUTDOWN after ${_scoot_tries} tries"
            break
        fi
        sleep 1
    done
    restore_session_env
}
trap 'cleanup; exit 129' HUP
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

# Who this session is, before anything the session starts could ask: the
# greeter sets this from the entry's `DesktopNames=scoot`, a hand run
# usually sets nothing. Default first, import after, so the manager and
# -- below -- the bus agree with what scoot's own children get (the
# compositor exports the same default to everything it spawns).
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-scoot}"

# The session type, unconditionally: this launcher starts exactly one
# thing -- a scoot Wayland session on this seat -- so `wayland` is
# always the true answer, whatever the login around it said. A greeter
# login usually arrives with `wayland` already (greetd derives it from
# the `wayland-sessions` entry, ReGreet passes it through), and then
# this changes nothing; a console login (`scoot-session` by hand from
# a VT, over ssh) arrives with it unset or `tty`, describing the
# terminal the launcher was run from rather than the session being
# started. Chrome is the reader that forces the point: without
# `XDG_SESSION_TYPE=wayland` it captures through X11 even on Wayland,
# so screen sharing in Meet stays dark unless every login -- greeter
# or console -- exports it. Set (not defaulted) before the `--all`
# sweep below, so the manager and the bus agree with scoot's children
# from the first import, and re-asserted by the scoped import once the
# display is known. (`XDG_CURRENT_DESKTOP` above stays a default: the
# greeter owns that name from `DesktopNames`, while no outer context
# owns this one.)
export XDG_SESSION_TYPE=wayland

# The login environment, whole, into the user manager AND the D-Bus
# activation environment together (`--systemd` does both -- that is the
# documented session-import mechanism, and it answers the
# which-tool question: `systemctl import-environment` alone would leave
# D-Bus-activated portals behind, which is half the point of this
# session). A wrong display swept in here (a greeter-owned
# `WAYLAND_DISPLAY`, say) is corrected by the scoped import below,
# which runs once the real display is known and overwrites it.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd --all \
        || die "could not import the login environment (see: journalctl --user)"
else
    # No dbus tool: the manager half only. (`import-environment` with
    # no names is deprecated upstream, but it still works; the scoped
    # import below then covers the bus half for the two variables that
    # matter.)
    systemctl --user import-environment \
        || die "could not import the login environment into the user manager"
fi

# Start the service. Plain `start`, deliberately not `--wait`: `--wait`
# hangs forever on some user managers even for already-active units
# (measured against systemd 261 on the dev VM: `systemctl --user --wait
# start` on an active unit never returns, with no job queued), which
# would wedge every login there. Nothing is lost: a start that fails
# outright (a missing binary, a bad unit) still exits nonzero at once,
# and a process that dies right after spawning trips the liveness check
# on the readiness loop's first round instead.
systemctl --user start "$SERVICE" || die "$SERVICE failed to start (see: journalctl --user -u $SERVICE)"

# Readiness: the IPC socket answers `version` (see `try_version`
# above). Poll, with a deadline -- never a blind sleep -- and bail
# the moment the service itself stops being active (a crash during
# startup must not burn the whole deadline). `scoot msg version` is
# the same client agents drive the session with, so "answers" means
# the loop that serves the session is running.
end=$(($(date +%s) + READY_TIMEOUT))
while :; do
    if try_version; then
        break
    fi
    # Only a definite down state ends the wait early: an unanswerable
    # manager (mid-re-exec) stays inside the deadline and retries,
    # loudly enough to explain the pause.
    service_up "$SERVICE"
    svc_rc=$?
    if [ "$svc_rc" -eq 2 ]; then
        note "user manager not answering while waiting for $SERVICE (re-exec?); retrying"
    elif [ "$svc_rc" -ne 0 ]; then
        die "$SERVICE stopped while starting (see: journalctl --user -u $SERVICE)"
    fi
    if [ "$(date +%s)" -ge "$end" ]; then
        stop_service || note "warning: could not stop $SERVICE; it may still be active (a later login heals or refuses it)"
        die "$SERVICE did not answer IPC within ${READY_TIMEOUT}s (see: journalctl --user -u $SERVICE)"
    fi
    sleep 1
done

# The display name: the session's own new socket, found by difference,
# never guessed. scoot binds `wayland-1` through `wayland-32` ignoring
# the caller's `WAYLAND_DISPLAY` (`compositor/wayland_accept.rs`), so
# pre-setting the name is not a mechanism -- and neither is the
# service's `/proc` environment, which cannot work: `set_var` moves
# `environ` off the initial stack, while `/proc/PID/environ` keeps
# showing the exec-time copy (measured live: the compositor answers IPC
# with no `WAYLAND_DISPLAY` in sight there). Exactly one socket new
# since the pre-start snapshot (by name AND inode, since a reused stale
# name is a replaced file) must exist: none means the compositor came
# up without one, and more than one means concurrent sessions -- either
# way the service is stopped and nothing is imported rather than a
# guess. A socket that vanishes between discovery and import is the
# same shape: stop, import nothing.
count=0
WAYLAND_DISPLAY=""
for sock in "$XDG_RUNTIME_DIR"/wayland-*; do
    [ -S "$sock" ] || continue
    name=${sock##*/}
    id=$(stat -c %i "$sock" 2>/dev/null || echo 0)
    case "$snap_before" in
        *" $name:$id "*) continue ;;
    esac
    count=$((count + 1))
    WAYLAND_DISPLAY=$name
done
if [ "$count" -ne 1 ]; then
    stop_service || note "warning: could not stop $SERVICE; it may still be active (a later login heals or refuses it)"
    die "found $count new Wayland sockets under \$XDG_RUNTIME_DIR after startup (expected exactly scoot's); stopped the service, nothing imported"
fi
if [ ! -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
    stop_service || note "warning: could not stop $SERVICE; it may still be active (a later login heals or refuses it)"
    die "the new Wayland socket vanished before it could be imported; stopped the service, nothing imported"
fi
export WAYLAND_DISPLAY

# The three session variables, into the user manager AND the D-Bus
# activation environment together (`--systemd` does both): units
# ordered after the session target inherit them from the manager, and
# D-Bus-activated portals (which inherit the bus's environment, not any
# client's) see them on the bus. This overwrites whatever the `--all`
# sweep above carried for these names (a greeter-owned display, an
# unset desktop, a console's `tty` session type), so the session's own
# values win. Scoped to these three because the login half was the
# place for the whole environment. This
# is the same three-var line `site/src/content/docs/scoot/index.md#starting-a-session` gives session
# scripts; here the launcher owns it, so systemd sessions need no script
# line, and the manual line stays for non-systemd setups.
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
        || note "warning: could not update the D-Bus activation environment; portals may miss this session"
else
    # No dbus tool: the manager half through `import-environment`
    # (all three variables are exported by now, so the names resolve), the
    # bus half missed with a warning.
    systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE \
        || note "warning: could not import the display into the user manager; units ordered after the session target may miss it"
    note "warning: no dbus-update-activation-environment on PATH; D-Bus-activated portals may miss this session"
fi

# The session target, started only now that the display is in the
# manager and on the bus: its `BindsTo` pulls in
# `graphical-session.target`, so the target is reached with the
# display already imported -- including for
# `ConditionEnvironment=WAYLAND_DISPLAY` units, which a start before
# the import would skip without retry. (The target carries
# `RefuseManualStart=yes` and can only be pulled in by a dependency
# like this one, never by `systemctl start` -- this start is that
# dependency.) A failure here leaves the service -- and nothing else
# -- active, so the service is stopped and nothing is imported past
# the pre-session state `die` restores.
#
# start_agent/stop_agent: the polkit agent in the session scope (see
# the header). Started here -- the display is known, the bus agrees,
# and the session is about to be declared ready, which is when
# prompts can first arrive. Supervised: a bare `&` would leave a
# zombie on death and never restart, failing every later prompt
# silently until re-login; the loop restarts after 2 s (the units'
# own backoff) and reaps each run. `XDG_SESSION_ID` is scrubbed from
# its environment: the launcher inherits the greeter's (or the
# console's), and a stale id would register the agent against the
# wrong session -- the scope membership below is the only signal it
# may use.
start_agent() {
    [ -n "${SCOOT_POLKIT_AGENT:-}" ] || return 0
    if [ ! -x "$SCOOT_POLKIT_AGENT" ]; then
        note "SCOOT_POLKIT_AGENT names nothing executable ($SCOOT_POLKIT_AGENT); no privilege prompts this session"
        return 0
    fi
    # Long-lived, so the liveness lock (fd 9, held by this launcher
    # until exit) must not leak into it: a second login would read
    # the lock as held-by-a-live-session and refuse. Close it in the
    # watcher -- and therefore in the agent -- before looping.
    # The watcher remembers the running agent and kills it when it is
    # itself told to stop, so `stop_agent` ends the agent too rather than
    # orphaning it into the scope. Both the agent and the backoff run in
    # the background and are waited on, so a stop interrupts either at
    # once instead of after the current run or the 2 s sleep.
    (
        exec 9>&-
        agent_pid=""
        trap 'if [ -n "$agent_pid" ]; then kill "$agent_pid" 2>/dev/null; fi; exit 0' TERM INT HUP
        while :; do
            env -u XDG_SESSION_ID "$SCOOT_POLKIT_AGENT" &
            agent_pid=$!
            wait "$agent_pid"
            agent_pid=""
            sleep 2 &
            wait "$!"
        done
    ) &
    agent_watch=$!
}
# stop_agent: end the supervised agent, if one is configured and
# running: the watcher kills the agent it is running, then exits. A
# missing watcher, a dead loop and a dead agent are all quiet no-ops (a
# logout races no teardown here).
stop_agent() {
    if [ -n "${agent_watch:-}" ]; then
        kill "$agent_watch" 2>/dev/null || true
        wait "$agent_watch" 2>/dev/null || true
        agent_watch=""
    fi
}
start_agent
systemctl --user start "$SESSION" \
    || { stop_service || note "warning: could not stop $SERVICE; it may still be active (a later login heals or refuses it)"; die "$SESSION failed to start (see: journalctl --user)"; }

# The session is up. Wait for it to end: scoot exiting (a `quit` action,
# a crash) inactivates the service, which ends this wait -- but only a
# definite down state ends it. The wait blocks in the bus on the unit's
# `PropertiesChanged` instead of polling: an idle session costs zero
# wakeups (no fork/exec, no manager round trip per second), and logout
# ends the wait the moment the state changes rather than on the next
# poll tick. Every wake re-asks the manager through `service_up`, so a
# spurious property change is one answered question, never an exit.
# A wake the manager never answers (mid-re-exec) is not "scoot exited":
# the bus connection itself survives a re-exec (measured on 261: a
# `daemon-reexec` neither wakes nor kills the wait), so a re-exec window
# usually passes with no wake at all. Unanswered re-asks are still
# counted, and tens of seconds of silence means the manager went away
# with the session (logout, shutdown): then exit instead of holding the
# liveness lock (which would refuse the next login) forever. If the
# blocking wait is unavailable (no `busctl`, a systemd older than the
# `wait` verb, a repeatedly failing bus) the loop falls back to the 1 s
# poll it replaces, loudly -- and keeps re-resolving every round, so a
# transient failure costs a second of polling, not the session.
# Cleanup below still runs first -- if the
# manager answers again its retry stops the compositor; if it never
# does, the units died with their manager and logind reaps the rest.
# (`cleanup` and the traps are defined up top, right after the
# environment capture, so the readiness wait above is covered too.)
#
# Subscribe-before-check, never the reverse: the waiter is spawned first
# and the state is asked after, so a stop landing between the two still
# wakes the waiter (its signal is already queued) and the re-ask ends
# the wait. Check-then-wait would miss exactly that signal and block
# until the next property change -- which may never come. The residual
# sliver -- the stop's signal emitted after the spawn but before the
# waiter's match is installed, while the re-ask still reads
# pre-transition state -- is bounded by `timeout 300` around the waiter
# (the same optional `timeout(1)` the readiness probe uses; without it
# the wait is unbounded): at most a five-minute stall, at most twelve
# idle re-asks an hour, and logout still ends the wait at once.
MANAGER_SILENCE_LIMIT=30
silence=0
wait_fails=0
unit_path=""
noted_poll=0
_scoot_waiter=""
have_timeout=0
if command -v timeout >/dev/null 2>&1; then
    have_timeout=1
fi
# reap_waiter: stop and reap the background unit waiter, if one is live.
# Every break path below calls it; `cleanup` calls it too, so a signal
# mid-wait leaves no orphaned bus connection. The pid is cleared once
# reaped, so a later kill can never touch a reused pid.
reap_waiter() {
    if [ -n "${_scoot_waiter:-}" ]; then
        kill "$_scoot_waiter" 2>/dev/null || true
        wait "$_scoot_waiter" 2>/dev/null || true
        _scoot_waiter=""
    fi
}
while :; do
    # (Re)resolve the blocking wait every round it is missing: a
    # transient failure -- a concurrent heal stopping the unit, a
    # mid-re-exec manager answering nothing -- must cost a second of
    # polling, not the whole session. While unresolved the loop polls,
    # loudly the first time and silently after; the moment the resolve
    # succeeds the wait engages and the polling stops.
    if [ -z "$unit_path" ] && command -v busctl >/dev/null 2>&1; then
        unit_path=$(service_object_path "$SERVICE") || unit_path=""
        if [ -n "$unit_path" ] && [ "$noted_poll" -eq 1 ]; then
            note "blocking unit wait available after all; watching $SERVICE without polling"
        fi
    fi
    if [ -z "$unit_path" ] && [ "$noted_poll" -eq 0 ]; then
        note "no blocking unit wait (no bus or $SERVICE not loaded); watching $SERVICE with a 1 s poll"
        noted_poll=1
    fi
    if [ -n "$unit_path" ]; then
        # `--quiet` keeps the signal payload off the greeter log.
        if [ "$have_timeout" -eq 1 ]; then
            timeout 300 busctl --user --quiet wait org.freedesktop.systemd1 "$unit_path" org.freedesktop.DBus.Properties PropertiesChanged 2>/dev/null &
        else
            busctl --user --quiet wait org.freedesktop.systemd1 "$unit_path" org.freedesktop.DBus.Properties PropertiesChanged 2>/dev/null &
        fi
        _scoot_waiter=$!
    fi
    service_up "$SERVICE"
    svc_rc=$?
    if [ "$svc_rc" -eq 0 ]; then
        silence=0
    elif [ "$svc_rc" -eq 2 ]; then
        silence=$((silence + 1))
        note "user manager not answering while watching $SERVICE (${silence}s of ${MANAGER_SILENCE_LIMIT}s; re-exec?); still watching"
        if [ "$silence" -ge "$MANAGER_SILENCE_LIMIT" ]; then
            note "$SERVICE state unknown for ${MANAGER_SILENCE_LIMIT}s; assuming the session is gone"
            reap_waiter
            break
        fi
        # Poll through the outage as the old 1 s loop did: the re-ask
        # above went unanswered, so this round's freshly spawned waiter
        # may already have missed its wake (a stop that woke the
        # previous waiter lands here as silence, and nothing will wake
        # the new one). Never block on it -- reap it and re-ask next
        # round. The idle path still costs zero: answered rounds block
        # below exactly as before.
        reap_waiter
        sleep 1
        continue
    else
        reap_waiter
        break
    fi
    if [ -n "$unit_path" ]; then
        # Block until any property of the service changes, then re-ask
        # above. Exit 124 is the `timeout 300` bound firing, not a bus
        # failure: re-ask and wait again. Any other nonzero exit is a
        # bus failure, not a state answer: back off one second per
        # failure, and past the bound stop hammering the bus and poll
        # instead (the resolve at the top of the loop re-engages the
        # wait the moment the bus answers again, and the next
        # `service_up` still ends the wait on a definite down state, so
        # this degrades volume, never correctness -- and a dead manager
        # still exits through the silence bound, a few seconds later
        # than the poll would have).
        wait "$_scoot_waiter"
        waiter_rc=$?
        _scoot_waiter=""
        if [ "$waiter_rc" -eq 0 ] || [ "$waiter_rc" -eq 124 ]; then
            wait_fails=0
        else
            wait_fails=$((wait_fails + 1))
            if [ "$wait_fails" -ge 5 ]; then
                note "blocking unit wait failed ${wait_fails} times; watching $SERVICE with a 1 s poll"
                unit_path=""
            fi
            sleep 1
        fi
    else
        sleep 1
    fi
done

trap - HUP INT TERM
cleanup

# Propagate the compositor's own exit status when it has one, so a
# greeter (or a log) sees a crash as a crash.
status=$(systemctl --user show --property ExecMainStatus --value "$SERVICE" 2>/dev/null) || status=""
case "$status" in
    '' | *[!0-9]*) exit 0 ;;
    *) exit "$status" ;;
esac
