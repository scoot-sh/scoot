#!/bin/sh
# scoot-look-pick: looks from the keyboard, through the launcher's dmenu
# contract (lines on stdin, the pick on stdout) until scootlaunch lands.
#
#   list            look names in catalog order, for the picker
#   menu            stdin's lines through fuzzel, the pick on stdout
#   pick            list through the menu, apply the choice
#
# `pick` is `list | menu | xargs scoot look apply`: the same `scoot look`
# machinery as the bar's looks picker, never a second implementation.
# Needs `scoot`, `fuzzel` and `python3` on PATH; a cancel applies nothing.
# No Nix needed: a plain install runs this from anywhere on PATH.

set -eu

fail() {
    echo "scoot-look-pick: $1" >&2
    exit 1
}

need() {
    command -v "$1" >/dev/null 2>&1 || fail "needs \`$1\` on PATH"
}

list() {
    need scoot
    need python3
    scoot look list --json | python3 -c 'import json,sys
for look in json.load(sys.stdin)["looks"]:
    print(look["name"])'
}

menu() {
    need fuzzel
    fuzzel --dmenu --prompt "Look: " || true
}

pick() {
    need scoot
    need python3
    need fuzzel
    names="$(list)"
    status=0
    choice="$(printf '%s\n' "$names" | menu)" || status=$?
    # A cancel is no output with a nonzero status: apply nothing. Any other
    # failure is loud.
    if [ "$status" -ne 0 ] && [ -z "$choice" ]; then
        exit 0
    fi
    [ "$status" -eq 0 ] || fail "the menu failed"
    [ -n "$choice" ] || exit 0
    exec scoot look apply "$choice"
}

case "${1:-pick}" in
    list) list ;;
    menu) menu ;;
    pick) pick ;;
    *) fail "takes list, menu or pick, not \`$1\`" ;;
esac
