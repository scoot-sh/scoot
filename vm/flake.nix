{
  description = "NixOS dev VM for scoot, bootable on macOS (QEMU + Hypervisor.framework)";

  inputs.nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";

  outputs =
    { self, nixpkgs }:
    let
      guestSystem = "aarch64-linux";
      hostSystem = "aarch64-darwin";
      hostPkgs = nixpkgs.legacyPackages.${hostSystem};

      # One definition, two instances: the second ("b") exists so two agents
      # can each have a VM (a build needs most of a VM's disk and cores).
      mkNixos =
        extra:
        nixpkgs.lib.nixosSystem {
          system = guestSystem;
          modules = [
            ./configuration.nix
            # The one line that makes this a Mac-native VM: NixOS builds the
            # launcher script with these pkgs, so `system.build.vm` is an
            # aarch64-darwin derivation that runs qemu directly on the host.
            { virtualisation.host.pkgs = hostPkgs; }
            extra
          ];
        };

      nixos = mkNixos { };

      # Instance b: ssh on 2223, a bigger disk (the first one fills up under
      # two cargo target trees), its own state directory (run-vm.sh).
      nixosB = mkNixos (
        { lib, ... }:
        {
          virtualisation.diskSize = lib.mkForce (64 * 1024);
          virtualisation.memorySize = lib.mkForce (12 * 1024);
          virtualisation.forwardPorts = lib.mkForce [
            {
              from = "host";
              host.address = "127.0.0.1";
              host.port = 2223;
              guest.port = 22;
            }
          ];
        }
      );

      # Generated by NixOS: creates the disk on first run, packs the store into
      # an erofs image, boots the kernel directly under HVF.
      runner = nixos.config.system.build.vm;

      # run-vm.sh only decides *where* state lives and what gets shared in;
      # everything else is the generated runner's job.
      mkRunVm =
        {
          name,
          vm,
          stateName,
          sshPort,
        }:
        hostPkgs.writeShellApplication {
          inherit name;
          runtimeInputs = [ hostPkgs.qemu ];
          text = ''
            SCOOT_VM_RUNNER=${nixpkgs.lib.getExe vm}
            export SCOOT_VM_RUNNER
            SCOOT_VM_STATE_NAME=${stateName}
            export SCOOT_VM_STATE_NAME
            SCOOT_VM_SSH_PORT=${toString sshPort}
            export SCOOT_VM_SSH_PORT
          ''
          + builtins.readFile ./run-vm.sh;
        };
      runVm = mkRunVm {
        name = "scoot-vm";
        vm = runner;
        stateName = "scoot-vm";
        sshPort = 2222;
      };
      runVmB = mkRunVm {
        name = "scoot-vm-b";
        vm = nixosB.config.system.build.vm;
        stateName = "scoot-vm-b";
        sshPort = 2223;
      };
    in
    {
      nixosConfigurations.scoot-vm = nixos;
      nixosConfigurations.scoot-vm-b = nixosB;

      packages.${hostSystem} = {
        default = runVm;
        vm = runVm;
        vm-b = runVmB;
        # The raw generated launcher, if you want to drive it yourself.
        inherit runner;
        # The Linux builder that builds the guest closure; see linux-builder.sh.
        # The stock 20G disk is tight for a VM this size, so ask for more. Only
        # applies when the builder's disk is created, i.e. delete
        # ~/.local/state/nix-linux-builder/*.qcow2 to pick it up.
        linux-builder = hostPkgs.darwin.linux-builder.override {
          # Only host-side settings belong here. `diskSize` affects the
          # launcher script (an aarch64-darwin derivation), so it stays
          # substitutable. Anything touching the *guest* -- nix.settings,
          # packages, services -- makes the builder's own closure need a Linux
          # builder to build, which deadlocks when the builder is down. Fix
          # the builder's download behaviour from the host instead, with
          # builders-use-substitutes (see README).
          modules = [ { virtualisation.darwin-builder.diskSize = 60 * 1024; } ];
        };
      };

      # Built on the Linux builder, then copied back to the Mac, which is where
      # the store image is packed from.
      packages.${guestSystem}.toplevel = nixos.config.system.build.toplevel;

      apps.${hostSystem}.default = {
        type = "app";
        program = "${runVm}/bin/scoot-vm";
      };
    };
}
