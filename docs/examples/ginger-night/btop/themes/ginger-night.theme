# The "ginger-night" btop theme: the illustration's palette on a transparent
# background, for a translucent terminal. Copy to ~/.config/btop/themes/ginger-night.theme
# (with ../btop.conf, which names it in `color_theme`).
theme[main_bg]=""
theme[main_fg]="#F5EAD6"
theme[title]="#F5EAD6"
theme[hi_fg]="#FFB14B"
theme[selected_bg]="#4A2C17"
theme[selected_fg]="#F5EAD6"
theme[inactive_fg]="#8F7A63"
theme[graph_text]="#C9B8A3"
theme[meter_bg]="#33261A"
theme[proc_misc]="#E57F29"
theme[cpu_box]="#8F7A63"
theme[mem_box]="#8F7A63"
theme[net_box]="#8F7A63"
theme[proc_box]="#8F7A63"
theme[div_line]="#4E2913"
theme[temp_start]="#8AA8A0"
theme[temp_mid]="#E57F29"
theme[temp_end]="#FFB14B"
theme[cpu_start]="#7E8AA0"
theme[cpu_mid]="#E57F29"
theme[cpu_end]="#FFB14B"
theme[free_start]="#8FA07A"
theme[free_mid]="#A9B98F"
theme[free_end]="#DCE8D2"
theme[cached_start]="#8F7A63"
theme[cached_mid]="#C9A87A"
theme[cached_end]="#C9B8A3"
theme[available_start]="#7E8AA0"
theme[available_mid]="#93A3B8"
theme[available_end]="#D2DCEC"
theme[used_start]="#C96A45"
theme[used_mid]="#FF9A30"
theme[used_end]="#FFB14B"
theme[download_start]="#8F7A63"
theme[download_mid]="#E57F29"
theme[download_end]="#FFB14B"
theme[upload_start]="#4E2913"
theme[upload_mid]="#C9A87A"
theme[upload_end]="#F5EAD6"
theme[process_start]="#7E8AA0"
theme[process_mid]="#E57F29"
theme[process_end]="#FFB14B"
