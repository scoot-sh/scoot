# The "vinyl sunset" btop theme: the illustration's palette on a transparent
# background, for a translucent terminal. Copy to ~/.config/btop/themes/vinyl.theme
# (with ../btop.conf, which names it in `color_theme`).
theme[main_bg]=""
theme[main_fg]="#F6E8CB"
theme[title]="#F6E8CB"
theme[hi_fg]="#FEC69A"
theme[selected_bg]="#582818"
theme[selected_fg]="#F6E8CB"
theme[inactive_fg]="#AC6F61"
theme[graph_text]="#EAC985"
theme[meter_bg]="#411711"
theme[proc_misc]="#FE9949"
theme[cpu_box]="#965C50"
theme[mem_box]="#965C50"
theme[net_box]="#965C50"
theme[proc_box]="#965C50"
