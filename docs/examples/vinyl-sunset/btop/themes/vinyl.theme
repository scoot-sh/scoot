# The "vinyl sunset" btop theme: the illustration's palette on a transparent
# background, for a translucent terminal. Copy to ~/.config/btop/themes/vinyl.theme
# (with ../btop.conf, which names it in `color_theme`).
theme[main_bg]=""
theme[main_fg]="#F1E3C6"
theme[title]="#F1E3C6"
theme[hi_fg]="#FDC58B"
theme[selected_bg]="#522C27"
theme[selected_fg]="#F6EAD2"
theme[inactive_fg]="#604F50"
theme[graph_text]="#DDB590"
theme[meter_bg]="#3A2A2E"
theme[proc_misc]="#E59560"
theme[cpu_box]="#7A6567"
theme[mem_box]="#7A6567"
theme[net_box]="#7A6567"
theme[proc_box]="#7A6567"
theme[div_line]="#604F50"
theme[temp_start]="#7FA3A0"
theme[temp_mid]="#E59560"
theme[temp_end]="#FDC58B"
theme[cpu_start]="#6F7CB3"
theme[cpu_mid]="#E59560"
theme[cpu_end]="#FDC58B"
theme[free_start]="#7FA08F"
theme[free_mid]="#9CBFA9"
theme[free_end]="#C9E0D2"
