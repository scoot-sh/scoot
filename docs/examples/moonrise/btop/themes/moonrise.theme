# The "moonrise" btop theme: the illustration's palette on a transparent
# background, for a translucent terminal. Copy to ~/.config/btop/themes/moonrise.theme
# (with ../btop.conf, which names it in `color_theme`).
theme[main_bg]=""
theme[main_fg]="#F6EEDC"
theme[title]="#F6EEDC"
theme[hi_fg]="#FFD54A"
theme[selected_bg]="#4E3B40"
theme[selected_fg]="#F6EEDC"
theme[inactive_fg]="#9C8B95"
theme[graph_text]="#C9BFAE"
theme[meter_bg]="#3A465A"
theme[proc_misc]="#FFA45C"
theme[cpu_box]="#9C8B95"
theme[mem_box]="#9C8B95"
theme[net_box]="#9C8B95"
theme[proc_box]="#9C8B95"
theme[div_line]="#5E4B5B"
theme[temp_start]="#7E9BB0"
theme[temp_mid]="#FFA45C"
theme[temp_end]="#FFD54A"
theme[cpu_start]="#7C8FB0"
theme[cpu_mid]="#FFA45C"
theme[cpu_end]="#FFD54A"
theme[free_start]="#8FA382"
theme[free_mid]="#A9BD9B"
theme[free_end]="#DCE8D2"
theme[cached_start]="#9C8B95"
theme[cached_mid]="#B595AD"
theme[cached_end]="#C9BFAE"
theme[available_start]="#7C8FB0"
theme[available_mid]="#93A8C8"
theme[available_end]="#D2DCEC"
theme[used_start]="#C96A63"
theme[used_mid]="#FF9A49"
theme[used_end]="#FFD54A"
theme[download_start]="#9C8B95"
theme[download_mid]="#FFA45C"
theme[download_end]="#FFD54A"
theme[upload_start]="#5E4B5B"
theme[upload_mid]="#B595AD"
theme[upload_end]="#F6EEDC"
theme[process_start]="#7C8FB0"
theme[process_mid]="#FFA45C"
theme[process_end]="#FFD54A"
