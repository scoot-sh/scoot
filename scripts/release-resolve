#!/usr/bin/env python3
"""Resolve and validate a release tag: the gate the tag-triggered release
workflow runs before it builds anything.

    scripts/release-resolve <tag> [--root DIR] [--main-ref REF]
                             [--no-github] [--complete-ok] [--json]

One tag, `vX.Y.Z`, releases every binary (scoot, which carries `scoot
msg`; scootbg; scootbar) at the repository's one version
(docs/versioning.md). The resolve refuses -- exit 2, nothing built,
nothing published -- when:

- the tag is not `vX.Y.Z`;
- the tag does not exist;
- the tag's version is not the `[workspace.package] version` at the
  tagged commit, or some crate there sets its own version instead of
  inheriting it (`scripts/workspace-version --check`);
- the tag's commit is not on the main line (`--main-ref`, default
  `origin/main`);
- the tag's GitHub release already holds every expected asset (a
  re-publish; an incomplete one resumes, so retries converge). With
  `--complete-ok` that is not a refusal but a finished release: the plan
  says `"complete": true`, exit 0, and the workflow skips the build. The
  release workflow passes it, because a maintainer's tag push and
  release-plz's dispatch can both reach one tag.

On success it prints the release plan (or `--json`: the same for the
workflow) and exits 0. The GitHub check needs `gh`; `--no-github`
skips it (local dry runs). Stdlib only; tests in
`scripts/test_release_resolve.py`.
"""

import argparse
import importlib.machinery
import importlib.util
import io
import json
import re
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# Every binary the repository ships. A crate without a binary (scootctl,
# the client library inside `scoot msg`; the internal libraries) carries
# the same version but has nothing of its own to release.
BINARIES = ("scoot", "scootbg", "scootbar")
ARCHES = ("x86_64-linux", "aarch64-linux")

TAG_RE = re.compile(r"^v(\d+\.\d+\.\d+)$")


def load_workspace_version():
    """scripts/workspace-version as a module: the one manifest reader."""
    path = Path(__file__).resolve().parent / "workspace-version"
    loader = importlib.machinery.SourceFileLoader("workspace_version", str(path))
    spec = importlib.util.spec_from_loader("workspace_version", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def git(*args, text=True):
    return subprocess.run(["git", *args], cwd=str(ROOT),
                          capture_output=True, text=text)


def refuse(message):
    print(f"release-resolve: refusing: {message}", file=sys.stderr)
    return 2


def manifests_at(commit, wv):
    """(workspace version, crates not inheriting it) at `commit`, read
    from the commit itself rather than the work tree: the build checks
    the tag out, so the tag's tree is what ships."""
    r = git("archive", "--format=tar", commit, "Cargo.toml", "crates",
            text=False)
    if r.returncode != 0:
        raise ValueError(f"cannot read the manifests at {commit[:8]}: "
                         f"{r.stderr.decode(errors='replace').strip()}")
    with tempfile.TemporaryDirectory(prefix="release-resolve-") as tmp:
        with tarfile.open(fileobj=io.BytesIO(r.stdout)) as tar:
            members = [m for m in tar.getmembers()
                       if m.name == "Cargo.toml"
                       or (m.name.endswith("/Cargo.toml")
                           and m.name.count("/") == 2)]
            # The "data" filter (refuse links and paths out of `tmp`)
            # where this Python has it; 3.14 makes it the default.
            safe = ({"filter": "data"} if hasattr(tarfile, "data_filter")
                    else {})
            tar.extractall(tmp, members=members, **safe)
        return wv.workspace_version(tmp), wv.non_inheriting(tmp)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("tag", help="release tag, e.g. v0.2.0")
    ap.add_argument("--root", default=None,
                    help="repo root (default: the checkout holding this script)")
    ap.add_argument("--main-ref", default="origin/main",
                    help="the main line the tag must be on (default origin/main)")
    ap.add_argument("--no-github", action="store_true",
                    help="skip the existing-release check (local dry runs)")
    ap.add_argument("--complete-ok", action="store_true",
                    help="a release already holding every asset is done, "
                         "not refused (exit 0, \"complete\": true)")
    ap.add_argument("--json", action="store_true",
                    help="print the release plan as JSON")
    a = ap.parse_args()

    global ROOT
    if a.root:
        ROOT = Path(a.root).resolve()

    m = TAG_RE.match(a.tag)
    if not m:
        return refuse(f"tag {a.tag!r} is not vX.Y.Z (one tag releases "
                      f"every binary; there are no per-package tags)")
    version = m.group(1)

    # The tag must exist: there is nothing to release otherwise.
    r = git("rev-parse", "--verify", f"refs/tags/{a.tag}^{{commit}}")
    if r.returncode != 0:
        return refuse(f"no such tag {a.tag!r} in this checkout")
    commit = r.stdout.strip()

    # The tag's version must be the workspace version at the tagged
    # commit, and every crate there must inherit it: a crate on a
    # version of its own would ship a binary that disagrees with the tag.
    try:
        manifest, bad = manifests_at(commit, load_workspace_version())
    except ValueError as e:
        return refuse(f"tag {a.tag}: {e}")
    if manifest != version:
        return refuse(f"tag {a.tag} names {version} but the workspace "
                      f"version at {commit[:8]} is {manifest} (tag the "
                      f"commit the release PR merged as)")
    if bad:
        return refuse(f"tag {a.tag}: these crates set their own version "
                      f"instead of the workspace's: {', '.join(bad)}")

    # The tag must be on the main line: releases cut from anywhere else
    # never went through main's CI.
    r = git("merge-base", "--is-ancestor", commit, a.main_ref)
    if r.returncode != 0:
        return refuse(f"tag {a.tag} ({commit[:8]}) is not on main "
                      f"({a.main_ref}): cut releases from main only")

    binaries = list(BINARIES)
    assets = ([f"{b}-{version}-{arch}" for b in binaries for arch in ARCHES]
              + [f"scoot-{version}-vendored.tar.gz",
                 f"sbom-scoot-{version}.cyclonedx.json",
                 "SHA256SUMS"])

    complete = False
    if not a.no_github:
        # First line: whether the release is still a draft (the publish
        # step uploads into a draft and un-drafts it last); then one asset
        # name per line. A draft is never complete, so a run that died
        # before un-drafting is resumed, not skipped or refused.
        r = subprocess.run(["gh", "release", "view", a.tag,
                            "--json", "isDraft,assets",
                            "--jq", ".isDraft, .assets[].name"],
                           capture_output=True, text=True)
        if r.returncode == 0:
            lines = [line.strip() for line in r.stdout.splitlines()
                     if line.strip()]
            draft = bool(lines) and lines[0] == "true"
            published = set(lines[1:])
            missing = [n for n in assets if n not in published]
            if draft and not missing:
                missing = ["(the release is still a draft)"]
            if not missing and a.complete_ok:
                complete = True
                print(f"release-resolve: tag {a.tag} is already published "
                      f"with all {len(assets)} assets: nothing to do",
                      file=sys.stderr)
            elif not missing:
                return refuse(f"tag {a.tag} is already published with "
                              f"all {len(assets)} assets: refusing a "
                              f"re-publish (delete the release to re-cut it)")
            elif draft and missing == ["(the release is still a draft)"]:
                print("release-resolve: incomplete release resumes: every "
                      "asset is up but the release is still a draft",
                      file=sys.stderr)
            else:
                print(f"release-resolve: incomplete release resumes: "
                      f"{len(missing)} of {len(assets)} assets still missing",
                      file=sys.stderr)
        elif "release not found" in (r.stdout + r.stderr).lower() or \
                "could not find" in (r.stdout + r.stderr).lower() or \
                "404" in (r.stdout + r.stderr):
            pass  # No release yet: the normal first-run path.
        else:
            return refuse(f"could not verify whether {a.tag} is already "
                          f"published: {r.stderr.strip() or r.stdout.strip()}"
                          f" (failing closed; --no-github skips this check)")

    plan = {"tag": a.tag, "version": version, "binaries": binaries,
            "commit": commit, "assets": assets, "complete": complete}
    if a.json:
        print(json.dumps(plan, indent=2))
    else:
        print(f"version={version}")
        print(f"binaries={' '.join(binaries)}")
        print(f"commit={commit}")
        print(f"complete={'true' if complete else 'false'}")
        print(f"assets ({len(assets)}):")
        for name in assets:
            print(f"  {name}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
